# 로컬 스택 자격증명 — 이 파일을 infra/.env 로 복사한 뒤 값을 채운다.
#   cp infra/.env.example infra/.env
# infra/.env 는 .gitignore 대상(커밋 금지). compose 는 프로젝트 디렉터리(infra/)의
# .env 를 자동 로드하고, 쉘 스크립트는 `set -a; . infra/.env; set +a` 로 읽는다.

# Postgres (소스 DB + Debezium 접속 계정)
POSTGRES_USER=settle
POSTGRES_PASSWORD=change-me

# MinIO 루트 계정 = S3 액세스키/시크릿 (DuckDB·Spark·Nessie 가 그대로 사용)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me

# Grafana 관리자 (익명 접근이 Admin 이라 로그인 자체는 거의 쓰지 않음)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
